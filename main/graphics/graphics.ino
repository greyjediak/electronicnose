// =====================================================================
//  graphics.ino -- TFT bring-up + Figma asset test for the e-nose.
//
//  Pins / driver / resolution live in display_config.h.
//  Images come from images.h, generated by tools/png2rgb565.py.
//
//  Cycles through:
//    1. Wiring/orientation test (color bars, labelled corners)
//    2. Each Figma image in images.h, centered
//    3. Animated loading spinner drawn in code (replaces static wheels)
// =====================================================================
#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ST7789.h>

#include "display_config.h"
#include "images.h"

// Optional pins: leave them undefined in display_config.h if not wired.
#ifndef TFT_RST
#define TFT_RST -1
#endif
#ifndef TFT_BL
#define TFT_BL -1
#endif

// Declared before any function so Arduino's auto-generated prototypes see it.
enum Screen : uint8_t { SCR_TEST, SCR_IMAGES, SCR_SPINNER };

Adafruit_ST7789 tft(TFT_CS, TFT_DC, TFT_RST);

static const uint32_t SCREEN_MS  = 3000;  // time on each test screen
static const uint32_t SPINNER_MS = 80;    // spinner frame period

// ---------- display setup ----------
void displayBegin() {
    if (TFT_BL >= 0) {
        pinMode(TFT_BL, OUTPUT);
        digitalWrite(TFT_BL, HIGH);
    }
    tft.init(TFT_WIDTH, TFT_HEIGHT);
    tft.setSPISpeed(TFT_SPI_HZ);
    tft.setRotation(TFT_ROTATION);
    tft.invertDisplay(TFT_INVERT);
    tft.fillScreen(TFT_BG_COLOR);
}

// ---------- screen 1: wiring / orientation ----------
void drawTestPattern() {
    const int16_t w = tft.width(), h = tft.height();
    const uint16_t bars[] = { ST77XX_RED, ST77XX_GREEN, ST77XX_BLUE,
                              ST77XX_WHITE, ST77XX_BLACK };
    const int16_t bw = w / 5;
    for (uint8_t i = 0; i < 5; i++) {
        tft.fillRect(i * bw, 0, bw, h, bars[i]);
    }
    tft.drawRect(0, 0, w, h, ST77XX_YELLOW);   // edge check: should be fully visible

    tft.setTextSize(2);
    tft.setTextColor(ST77XX_YELLOW, ST77XX_BLACK);
    tft.setCursor(4, 4);           tft.print("TL");
    tft.setCursor(w - 28, h - 20); tft.print("BR");
    tft.setCursor(4, h / 2 - 8);
    tft.print(w); tft.print('x'); tft.print(h); tft.print(" r"); tft.print(TFT_ROTATION);
}

// ---------- screen 2: Figma images ----------
void drawImage(const ImageAsset& img) {
    tft.fillScreen(TFT_BG_COLOR);
    int16_t x = (tft.width()  - (int16_t)img.w) / 2;
    int16_t y = (tft.height() - (int16_t)img.h) / 2;
    tft.drawRGBBitmap(x, y, img.data, img.w, img.h);

    tft.setTextSize(1);
    tft.setTextColor(ST77XX_WHITE, TFT_BG_COLOR);
    tft.setCursor(2, tft.height() - 10);
    tft.print(img.name);
}

// ---------- screen 3: animated spinner ----------
// 12 dots on a circle; the "head" dot is bright and the tail fades.
void drawSpinnerFrame(int16_t cx, int16_t cy, int16_t r, uint8_t frame) {
    const uint8_t  N = 12;
    const uint16_t shades[] = { 0xFFFF, 0xBDF7, 0x7BEF, 0x39E7 };
    for (uint8_t i = 0; i < N; i++) {
        float a = (2.0f * PI * i) / N;
        int16_t x = cx + (int16_t)(r * cosf(a));
        int16_t y = cy + (int16_t)(r * sinf(a));
        uint8_t age = (uint8_t)((frame - i + N) % N);
        uint16_t c = age < 4 ? shades[age] : 0x2104;
        tft.fillCircle(x, y, 4, c);
    }
}

// ---------- screen sequencer ----------
Screen   screen      = SCR_TEST;
uint8_t  imageIndex  = 0;
uint32_t screenStart = 0;

void enterScreen(Screen s) {
    screen = s;
    screenStart = millis();
    switch (s) {
        case SCR_TEST:
            drawTestPattern();
            break;
        case SCR_IMAGES:
            drawImage(IMAGES[imageIndex]);
            break;
        case SCR_SPINNER:
            tft.fillScreen(TFT_BG_COLOR);
            tft.setTextSize(2);
            tft.setTextColor(ST77XX_WHITE, TFT_BG_COLOR);
            tft.setCursor(tft.width() / 2 - 54, tft.height() / 2 + 50);
            tft.print("Warming up");
            break;
    }
    Serial.print("screen ");
    Serial.println((int)s);
}

void nextScreen() {
    switch (screen) {
        case SCR_TEST:
            if (IMAGE_COUNT > 0) { imageIndex = 0; enterScreen(SCR_IMAGES); }
            else                 { enterScreen(SCR_SPINNER); }
            break;
        case SCR_IMAGES:
            if (++imageIndex < IMAGE_COUNT) enterScreen(SCR_IMAGES);
            else                            enterScreen(SCR_SPINNER);
            break;
        case SCR_SPINNER:
            enterScreen(SCR_TEST);
            break;
    }
}

void setup() {
    Serial.begin(115200);
    displayBegin();
    enterScreen(SCR_TEST);
}

void loop() {
    if (screen == SCR_SPINNER) {
        static uint32_t lastFrame = 0;
        static uint8_t  frame = 0;
        if (millis() - lastFrame >= SPINNER_MS) {
            lastFrame = millis();
            drawSpinnerFrame(tft.width() / 2, tft.height() / 2 - 10, 30, frame++);
        }
    }
    if (millis() - screenStart >= SCREEN_MS) {
        nextScreen();
    }
}
